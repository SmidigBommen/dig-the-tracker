# Local Compose settings. Register the callback URL with the provider.
DATABASE_URL=postgres://dig:dig-local-only@127.0.0.1:5432/dig
API_HOST=127.0.0.1
API_PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=dig-local
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8080/api/auth/callback

# Comma-separated OpenID Connect subject claims allowed to create Spaces.
INSTALLATION_ADMIN_SUBJECTS=replace-with-your-subject

# Use a different random value outside disposable local development.
SESSION_SECRET=replace-with-at-least-32-random-characters
