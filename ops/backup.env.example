# Install as /etc/dig/backup.env, owned by the operator, mode 0600.
# Never commit the completed file. Values below are placeholders.
DATABASE_URL=postgres://dig:replace-password@127.0.0.1:5432/dig
# For a Coolify database, run PostgreSQL 16 tools inside its container.
PG_TOOLS_CONTAINER=replace-with-database-container-name
S3_BUCKET=replace-with-private-off-server-bucket
S3_ENDPOINT=https://replace-with-provider-endpoint
AWS_DEFAULT_REGION=replace-with-provider-region
AWS_ACCESS_KEY_ID=replace-with-backup-writer-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-writer-secret
BACKUP_STATE_FILE=/var/lib/dig-operations/backup-state.json
DIG_PUBLIC_URL=https://dig.smidigbommen.no
# Set to the actual host filesystem holding the database volume.
DIG_DATA_PATH=/var/lib/docker/volumes
