{
  "name": "dig-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run build:api && node --env-file-if-exists=.env.local api-dist/server.js",
    "build": "tsc -b && npm run build:api && vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "migrate": "npm run build:api && node --env-file-if-exists=.env.local api-dist/migrate.js up",
    "start:api": "node api-dist/server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "./scripts/test-db",
    "test:db:running": "npm run build:api && node api-dist/migrate.js up && DIG_DATABASE_TESTS=1 vitest run --no-file-parallelism api/modules/*.integration.test.ts",
    "test:watch": "vitest",
    "container:build": "podman build -t dig-tracker -f Containerfile .",
    "container:run": "podman run --rm -p 127.0.0.1:8080:8080 dig-tracker",
    "db:up": "./scripts/compose -f podman-compose.yml up -d db",
    "db:migrate": "npm run migrate",
    "db:reset": "npm run build:api && node --env-file-if-exists=.env.local api-dist/migrate.js reset",
    "db:backup": "node scripts/database-archive.mjs backup",
    "db:restore": "node scripts/database-archive.mjs restore",
    "db:down": "./scripts/compose -f podman-compose.yml down",
    "test:e2e": "npm run build && playwright test",
    "test:recovery": "npm run build:api && node scripts/test-recovery.mjs && node scripts/test-backup.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "jose": "^6.2.11",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.20.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
